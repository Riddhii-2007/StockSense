# StockSense Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database
# Leave DB_DRIVER unset to use the built-in SQLite driver (no server, no
# install, works offline). Setting DATABASE_URL switches to PostgreSQL.
#
# Supabase -> Project Settings -> Database -> Connection string -> URI
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Supabase REST credentials. OPTIONAL and only used by GET /api/db-test, which
# probes PostgREST to confirm the project is reachable and the schema is visible
# over the API. The app itself reads and writes through DATABASE_URL above, so
# these are not required to run.
#
# The service role key bypasses row level security. Never ship it to the browser
# and never commit it. Rotate it if it has ever been pasted into a chat, a
# screenshot, or a shared doc.
# SUPABASE_URL=https://YOUR_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Return the 6-digit OTP in the /auth/request-otp response so the password
# reset flow can be demonstrated without a mail provider.
# Forced off when NODE_ENV=production.
ECHO_OTP=true

# Signs demo session tokens. Change for any real deployment.
SESSION_SECRET=stocksense-dev-secret

# Optional. Without a key the natural language parser falls back to
# deterministic rules, which handle the documented demo phrasings.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-sonnet-4-5
